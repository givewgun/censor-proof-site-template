# Burnable Independent Volunteer Clearnet Mirror (Caddy v2) — ADR-004
# Deploy ONLY on an offshore server outside Thailand, completely decoupled from
# the canonical Tor .onion VPS.

{
    # Disable admin API and minimize operational metadata
    admin off
}

mirror.example.org {
    root * /var/www/archive/site
    file_server

    # Zero visitor access logs
    log {
        output discard
    }

    # Auto-upgrade Tor Browser & Brave visitors to the canonical Tor v3 onion
    header {
        Onion-Location "http://replace-with-56-char-v3-onion-address-examplexxxxxxxxxxxxxx.onion{uri}"
        Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        -Server
    }

    @disallowed {
        not method GET HEAD
    }
    respond @disallowed 405
}
